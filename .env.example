# Copy to /etc/coalesc.env (or export) and edit. All values are optional.
COALESC_BIN_DIR=/opt/compbio/conda/envs/pytorch-env/bin
COALESC_UPLOAD_DIR=/opt/compbio/cdhit-server/uploads
COALESC_RESULTS_DIR=/opt/compbio/cdhit-server/results
COALESC_MAX_UPLOAD_MB=500
COALESC_JOB_TIMEOUT_S=7200
COALESC_KEEP_UPLOADS=0
COALESC_HOST=0.0.0.0
COALESC_PORT=8001
